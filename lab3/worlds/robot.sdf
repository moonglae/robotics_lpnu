<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="lab1_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                </collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                    <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
                </visual>
            </link>
        </model>

        <model name='vehicle_blue'>
            <pose>0 0 0.325 0 0 0</pose>
            <link name='chassis'>
                <pose>-0.15 0 0.175 0 0 0</pose>
                <inertial>
                    <mass>1.14395</mass>
                    <inertia>
                        <ixx>0.126</ixx><ixy>0</ixy><ixz>0</ixz>
                        <iyy>0.416</iyy><iyz>0</iyz>
                        <izz>0.481</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry><box><size>2.0 1.0 0.5</size></box></geometry>
                    <material><ambient>0.0 0.0 1.0 1</ambient><diffuse>0.0 0.0 1.0 1</diffuse></material>
                </visual>
                <collision name='collision'>
                    <geometry><box><size>2.0 1.0 0.5</size></box></geometry>
                </collision>
            </link>

            <link name='left_wheel_front'>
                <pose>0.6 0.625 -0.025 -1.5707 0 0</pose>
                <collision name='collision'>
                    <geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry>
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
                <visual name='visual'><geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry></visual>
            </link>

            <link name='left_wheel_rear'>
                <pose>-0.6 0.625 -0.025 -1.5707 0 0</pose>
                <collision name='collision'>
                    <geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry>
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
                <visual name='visual'><geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry></visual>
            </link>

            <link name='right_wheel_front'>
                <pose>0.6 -0.625 -0.025 -1.5707 0 0</pose>
                <collision name='collision'>
                    <geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry>
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
                <visual name='visual'><geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry></visual>
            </link>

            <link name='right_wheel_rear'>
                <pose>-0.6 -0.625 -0.025 -1.5707 0 0</pose>
                <collision name='collision'>
                    <geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry>
                    <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
                </collision>
                <visual name='visual'><geometry><cylinder><radius>0.3</radius><length>0.125</length></cylinder></geometry></visual>
            </link>

            <joint name='left_wheel_front_joint' type='revolute'><parent>chassis</parent><child>left_wheel_front</child><axis><xyz>0 0 1</xyz></axis></joint>
            <joint name='left_wheel_rear_joint' type='revolute'><parent>chassis</parent><child>left_wheel_rear</child><axis><xyz>0 0 1</xyz></axis></joint>
            <joint name='right_wheel_front_joint' type='revolute'><parent>chassis</parent><child>right_wheel_front</child><axis><xyz>0 0 1</xyz></axis></joint>
            <joint name='right_wheel_rear_joint' type='revolute'><parent>chassis</parent><child>right_wheel_rear</child><axis><xyz>0 0 1</xyz></axis></joint>

            <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                <left_joint>left_wheel_front_joint</left_joint>
                <left_joint>left_wheel_rear_joint</left_joint>
                <right_joint>right_wheel_front_joint</right_joint>
                <right_joint>right_wheel_rear_joint</right_joint>
                <wheel_separation>1.25</wheel_separation>
                <wheel_radius>0.3</wheel_radius>
                <odom_publish_frequency>20</odom_publish_frequency>
                <topic>cmd_vel</topic>
            </plugin>
        </model>
    </world>
</sdf>